# ────────────────────────────────────────────────────────
# Multi-Agent Email Assistant – Environment Configuration
# Copy this file to .env and fill in your values.
# ────────────────────────────────────────────────────────

# ── OpenAI ───────────────────────────────────────────────
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT=30
OPENAI_MAX_RETRIES=3

# ── Database ─────────────────────────────────────────────
DB_PATH=email_assistant.db

# ── Email Source ─────────────────────────────────────────
# Options: dummy | gmail
EMAIL_SOURCE=dummy
DUMMY_DATA_PATH=data/dummy_emails.json

# ── Gmail OAuth (required only when EMAIL_SOURCE=gmail) ──
GMAIL_CREDENTIALS_PATH=credentials.json
GMAIL_TOKEN_PATH=token.json
GMAIL_MAX_RESULTS=20

# ── Pipeline ─────────────────────────────────────────────
PARALLEL_AGENTS=true
MAX_CONCURRENT_EMAILS=5
ENABLE_AUTO_REPLY=false  # set true to enable reply drafting
